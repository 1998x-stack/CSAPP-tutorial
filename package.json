{
  "name": "csapp-tutorial",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "npm run docs:build",
    "check:content": "node scripts/validate-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:snippets": "python3 scripts/verify-snippets.py",
    "check:output": "node scripts/validate-build.mjs",
    "test": "npm run test:content && npm run test:labs",
    "test:e2e": "playwright test",
    "test:labs": "cmake -S . -B .build/labs -DCMAKE_BUILD_TYPE=Debug && cmake --build .build/labs --parallel && ctest --test-dir .build/labs --output-on-failure",
    "test:content": "npm run check:content && npm run check:links && npm run check:snippets"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "vitepress": "1.6.4"
  }
}
